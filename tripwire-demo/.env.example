# Copy to tripwire-demo/.env (gitignored). Never commit real tokens.
PORT=8787
DEMO_KEY=change-me
# mock = log hits to the console; spacetime = report to SpacetimeDB.
# Default: spacetime when a token is found (root .env SPACETIME_TOKEN), else mock.
# MODE=mock
# URL the attacker's machine can reach (used inside decoy files). Use a tunnel URL for a remote demo.
RELAY_PUBLIC_URL=http://localhost:8787
# Set to 1 only behind a trusted reverse proxy/tunnel, to log X-Forwarded-For as source IP.
TRUST_PROXY=0
# Seconds between arming steps in the UI animation (milliseconds)
ARM_STEP_MS=700

# Hits from loopback are reported with this source IP (empty = report the real IP)
DEMO_SOURCE_IP=10.20.4.17

# --- SpacetimeDB. By default the relay reads SPACETIME_TOKEN and RP_DB_DEV from
# the repo root .env. Set these only to override.
STDB_HOST=https://maincloud.spacetimedb.com
# STDB_DB=red-phone-6h786-dev
# STDB_TOKEN=
# Optional override token for plant_tripwire / reset_tripwire_demo only
# STDB_ADMIN_TOKEN=
